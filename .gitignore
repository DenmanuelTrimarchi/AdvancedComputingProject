# Biometric research inputs and derived artifacts never belong in Git.
.venv/
.env
data/*
!data/README.md
datasets/
*.tgz
*.tar.gz
*.zip
*.rar
models/*.onnx
models/*.bin
cache/
*.sqlite
*.db
results/raw/
results/pair_scores/
# Raw local command logs behind the rendered evidence images. Redacted at
# write time, but kept out of Git by default -- the committed evidence is the
# PNG pack, the index and the manifest.
results/report_evidence/logs/
__pycache__/
.pytest_cache/
.coverage
htmlcov/
.DS_Store

# Standard Python packaging noise
*.egg-info/
build/
dist/
.mypy_cache/
.ruff_cache/

# Allow disclosure-reviewed aggregate results
!results/aggregate/
!results/historical/
!results/report_evidence/
!results/README.md
