# Copy to .env and fill in with paths inside your access-controlled Arden
# University OneDrive research folder. Per the project's ethics form, all
# benchmark images, protocols, derived embeddings, temporary scores and
# research databases must be stored exclusively within that AU OneDrive
# location -- never in this Git repository, a personal drive, or any
# personal (non-institutional) cloud service (see docs/DATA_MANAGEMENT.md).

# Root containing extracted dataset image directories (e.g. lfw_funneled/, cplfw/).
FACE_DATA_ROOT=/path/to/AU-OneDrive/face-verification/datasets

# Root containing official pair-protocol files (pairsDevTrain.txt, pairsDevTest.txt,
# pairs.txt, pairs_CPLFW.txt).
FACE_PROTOCOL_ROOT=/path/to/AU-OneDrive/face-verification/protocols

# Root containing the two pinned OpenCV Zoo model files (.onnx).
FACE_MODEL_ROOT=/path/to/AU-OneDrive/face-verification/models

# Root for optional embedding cache. Disabled by default; only enable this if
# you understand the cache will contain biometric templates (see
# docs/ETHICS_AND_BIOMETRICS.md) and can restrict its permissions accordingly.
FACE_CACHE_ROOT=/path/to/AU-OneDrive/face-verification/cache
