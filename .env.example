# Copy to .env and fill in with your own secure, non-repo storage location.
# Never point these at a path inside this Git repository, Dropbox, Google
# Drive, or any other synced/cloud-backed folder unless expressly approved in
# a revised data-management plan (see docs/DATA_MANAGEMENT.md).

# Root containing extracted dataset image directories (e.g. lfw_funneled/, cplfw/).
FACE_DATA_ROOT=/secure/path/face-verification/datasets

# Root containing official pair-protocol files (pairsDevTrain.txt, pairsDevTest.txt,
# pairs.txt, pairs_CPLFW.txt).
FACE_PROTOCOL_ROOT=/secure/path/face-verification/protocols

# Root containing the two pinned OpenCV Zoo model files (.onnx).
FACE_MODEL_ROOT=/secure/path/face-verification/models

# Root for optional embedding cache. Disabled by default; only enable this if
# you understand the cache will contain biometric templates (see
# docs/ETHICS_AND_BIOMETRICS.md) and can restrict its permissions accordingly.
FACE_CACHE_ROOT=/secure/path/face-verification/cache
